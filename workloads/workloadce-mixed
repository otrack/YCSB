# YCSB+T: Closed Economy Workload with Mixed Operations
# Workload CE-Mixed: Closed Economy with mixed reads and transfers
#   Application example: Banking application with account checks and transfers
#
#   Read/read-modify-write ratio: 50/50
#   Default data size: Single field per record containing a numeric value
#   Request distribution: zipfian
#   Validation: Total sum should remain 0 across all accounts (all start at 0)

recordcount=1000
operationcount=1000
workload=site.ycsb.workloads.ClosedEconomyWorkload

# Transaction proportions
readproportion=0.5
updateproportion=0
insertproportion=0
scanproportion=0
readmodifywriteproportion=0.5

# Request distribution
requestdistribution=zipfian

# Field configuration
fieldcount=1
readallfields=true
writeallfields=false

# Validation method
validatebyquery=false
