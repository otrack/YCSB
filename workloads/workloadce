# YCSB+T: Closed Economy Workload
# Workload CE: Closed Economy with Read-Modify-Write Transactions
#   Application example: Banking application with account transfers
#
#   Read/update/read-modify-write ratio: 0/0/100
#   Default data size: Single field per record containing a numeric value
#   Request distribution: uniform
#   Validation: Total cash should remain constant across all accounts

recordcount=1000
operationcount=1000
workload=site.ycsb.workloads.ClosedEconomyWorkload

# Total cash in the economy (will be distributed equally across records)
totalcash=1000000

# Transaction proportions
readproportion=0
updateproportion=0
insertproportion=0
scanproportion=0
readmodifywriteproportion=1.0

# Request distribution
requestdistribution=uniform

# Field configuration
fieldcount=1
readallfields=true
writeallfields=false

# Validation method
validatebyquery=false
