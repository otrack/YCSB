<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>site.ycsb</groupId>
    <artifactId>binding-parent</artifactId>
    <version>0.18.0-SNAPSHOT</version>
    <relativePath>../binding-parent</relativePath>
  </parent>
  
  <artifactId>tiga-binding</artifactId>
  <name>Tiga DB Binding</name>
  <packaging>jar</packaging>

  <dependencies>
    <dependency>
      <groupId>site.ycsb</groupId>
      <artifactId>core</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.tiga</groupId>
      <artifactId>ycsb-jni</artifactId>
      <version>1.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>fetch-native-libs</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bash</executable>
              <arguments>
                <argument>-c</argument>
                <argument>
                  set -e
                  DEST="${project.build.directory}/generated-resources/main"
                  mkdir -p "$DEST"
                  if command -v docker &gt;/dev/null 2&gt;&amp;1 &amp;&amp; docker ps &gt;/dev/null 2&gt;&amp;1; then
                    echo "[INFO] Extracting native libraries from 0track/tiga-suite:latest via Docker..."
                    CONTAINER_ID=$(docker create 0track/tiga-suite:latest)
                    trap 'docker rm -f $CONTAINER_ID &gt;/dev/null 2&gt;&amp;1 || true' EXIT
                    docker cp "$CONTAINER_ID:/usr/local/lib/libtigaycsb.so" "$DEST/"
                    docker cp "$CONTAINER_ID:/usr/local/lib/libjanusycsb.so" "$DEST/"
                  elif [ -f "$DEST/libtigaycsb.so" ] &amp;&amp; [ -f "$DEST/libjanusycsb.so" ]; then
                    echo "[INFO] Native libraries present in $DEST."
                  elif [ -f "/usr/local/lib/libtigaycsb.so" ]; then
                    echo "[INFO] Copying native libraries from /usr/local/lib..."
                    cp /usr/local/lib/lib*ycsb.so "$DEST/"
                  else
                    echo "[WARNING] Docker daemon not available and native libraries not found."
                  fi
                </argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>${project.build.directory}/generated-resources/main</directory>
      </resource>
    </resources>
  </build>
</project>
